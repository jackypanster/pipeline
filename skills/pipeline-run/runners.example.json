{
  "_comment": "Operator-local config (~/.config/pipeline/runners.json). NEVER commit to Git. Any model/CLI may fill any role as long as reviewer.model_id differs from BOTH planner.model_id and implementer.model_id AND each command explicitly binds its selected model.",
  "planner": {
    "model_id": "Gemini 4 Neon (High)",
    "argv": ["agy", "-p", "--mode", "auto", "--model", "Gemini 4 Neon (High)", "--dangerously-skip-permissions", "{prompt}"],
    "prompt_via": "arg",
    "timeout_s": 900
  },
  "implementer": {
    "model_id": "group/pi-main",
    "argv": ["pi", "-p", "--no-session", "--no-mcp", "--model", "group/pi-main", "--", "{prompt}"],
    "prompt_via": "arg",
    "timeout_s": 1800
  },
  "reviewer": {
    "model_id": "gpt-6.2-astra",
    "argv": ["codex", "exec", "-s", "read-only", "-m", "gpt-6.2-astra", "-"],
    "prompt_via": "stdin",
    "timeout_s": 600
  },
  "_swappable_examples": {
    "planner_claude": {
      "model_id": "opus",
      "argv": ["claude", "-p", "--model", "opus", "--permission-mode", "acceptEdits", "{prompt}"],
      "prompt_via": "arg",
      "timeout_s": 900
    },
    "implementer_claude": {
      "model_id": "sonnet",
      "argv": ["claude", "-p", "--model", "sonnet", "--permission-mode", "acceptEdits", "{prompt}"],
      "prompt_via": "arg",
      "timeout_s": 1800
    },
    "reviewer_claude": {
      "model_id": "opus",
      "argv": ["claude", "-p", "--model", "opus", "--permission-mode", "plan", "{prompt}"],
      "prompt_via": "arg",
      "timeout_s": 600
    }
  }
}
